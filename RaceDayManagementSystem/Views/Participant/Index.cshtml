@model RaceDayManagementSystem.Models.Participant;

@{
    ViewData["Title"] = "Participant Registration";
}

<style>
    .register-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px 0;
    }
    .register-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        padding: 40px;
        max-width: 550px;
        width: 100%;
        background: #ffffff;
    }
    .form-control {
        border-radius: 10px;
        padding: 12px;
    }
    .btn-custom {
        border-radius: 10px;
        padding: 12px;
        font-weight: 600;
        font-size: 1.1rem;
    }
</style>

<div class="register-container">
    <div class="register-card">
        
        <div class="text-center mb-4">
            <h2 class="fw-bold">Create an Account</h2>
            <p class="text-muted">Join RaceDay as a Participant</p>
        </div>

        <form asp-action="Registration" method="post">
            
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Row for Name and Surname to save space -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Pname" class="form-label fw-semibold">Name</label>
                    <input asp-for="Pname" class="form-control" placeholder="First name" />
                    <span asp-validation-for="Pname" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Psurname" class="form-label fw-semibold">Surname</label>
                    <input asp-for="Psurname" class="form-control" placeholder="Last name" />
                    <span asp-validation-for="Psurname" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Pusername" class="form-label fw-semibold">Username</label>
                <input asp-for="Pusername" class="form-control" placeholder="Choose a username" />
                <span asp-validation-for="Pusername" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Ppassword" class="form-label fw-semibold">Password</label>
                <!-- Added type="password" to hide the text -->
                <input asp-for="Ppassword" class="form-control" type="password" placeholder="Create a strong password" />
                <span asp-validation-for="Ppassword" class="text-danger"></span>
            </div>

            <div class="d-grid gap-3 mt-4">
                <button type="submit" class="btn btn-primary btn-custom">
                    Register Account
                </button>
            </div>

        </form>

        <div class="text-center mt-4">
            <p class="mb-0 text-muted">Already have an account?</p>
            <a asp-controller="Login" asp-action="ParticipantLogin" class="text-decoration-none fw-semibold">Log in here</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}