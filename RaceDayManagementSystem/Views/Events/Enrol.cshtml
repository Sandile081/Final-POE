@{
    ViewData["Title"] = "Enrol in Event";
}

<style>
    .enrol-container {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .enrol-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        padding: 40px;
        max-width: 500px;
        width: 100%;
        background: #ffffff;
    }
    .form-control {
        border-radius: 10px;
        padding: 12px;
        font-size: 1.1rem;
    }
    .btn-custom {
        border-radius: 10px;
        padding: 12px;
        font-weight: 600;
        font-size: 1.1rem;
    }
</style>

<div class="enrol-container">
    <div class="enrol-card">
        
        <!-- Header -->
        <div class="text-center mb-4">
            <div class="mb-3">
                <i class="bi bi-ticket-perforated-fill text-primary" style="font-size: 3rem;"></i>
            </div>
            <h2 class="fw-bold">Confirm Enrolment</h2>
            <p class="text-muted">You are enrolling in <strong>@ViewBag.EventName</strong></p>
        </div>

        <form asp-action="Enrol" method="post">
            
            <!-- Hidden Inputs -->
            <input type="hidden" name="eventId" value="@ViewBag.EventID" />
            <input type="hidden" name="categoryId" value="@ViewBag.CategoriesID" />

            <!-- Validation Summary -->
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <!-- Age Input -->
            <div class="mb-4">
                <label for="age" class="form-label fw-semibold">Please enter your age</label>
                <input type="number" name="age" class="form-control" min="1" max="100" placeholder="e.g. 25" required />
                <div class="form-text mt-2">
                    <i class="bi bi-info-circle"></i> We use this to place you in the correct race category based on age limits.
                </div>
            </div>

            <!-- Buttons -->
            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-primary btn-custom">
                    <i class="bi bi-check-circle-fill me-2"></i> Confirm Enrolment
                </button>
                <a asp-action="Index" class="btn btn-light border btn-custom text-muted">
                    Cancel
                </a>
            </div>

        </form>

    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">