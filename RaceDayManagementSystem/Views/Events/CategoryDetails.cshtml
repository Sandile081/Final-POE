@model RaceDayManagementSystem.Models.Categories;

@{
	ViewData["Title"] = "Event Catagory Details";
}

<h1>Event Catagory Details</h1>

<dl class="row">
	<dt class="col-sm-2">Id</dt>
	<dd class="col-sm-10">@Model.CategoriesID</dd>

	<dt class="col-sm-2">Age</dt>
	<dd class="col-sm-10">@Model.Age</dd>

	<dt class="col-sm-2">Categroy Type</dt>
	<dd class="col-sm-10">@Model.categoryType</dd>

	<dt class="col-sm-2">MaxKM</dt>
	<dd class="col-sm-10">@Model.MaxKM</dd>

	<dt class="col-sm-2">MinKM</dt>
	<dd class="col-sm-10">@Model.MinKM</dd>


</dl>


<a asp-action="EditCategory" asp-route-id="@Model.CategoriesID" class="btn btn-secondary">Edit Category</a>

<a asp-controller="Events" asp-action="OrganiserEvents" class="btn btn-secondary">Back to List</a>

