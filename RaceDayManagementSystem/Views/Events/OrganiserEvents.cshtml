@model IEnumerable<RaceDayManagementSystem.Models.Events>

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<!-- Success/Error Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container mt-4">
    
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Events Dashboard</h2>
            <p class="text-muted mb-0">Manage your events and view participants.</p>
        </div>
        <a asp-controller="Location" asp-action="Index" class="btn btn-primary shadow-sm fw-semibold px-4 py-2">
            <i class="bi bi-plus-lg"></i> Create New Event
        </a>
    </div>

    <!-- Cards Container -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var ev in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
                    
                    <!-- Banner Image -->
                    @if (!string.IsNullOrEmpty(ev.BannerUrl))
                    {
                        <img src="@ev.BannerUrl" class="card-img-top" alt="@ev.EventName" style="height: 180px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary d-flex align-items-center justify-content-center text-white" style="height: 180px;">
                            <span class="fs-5">No Banner Uploaded</span>
                        </div>
                    }

                    <!-- Card Body -->
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">@ev.EventName</h5>
                            <span class="badge bg-light text-dark border">@ev.EventType</span>
                        </div>
                        
                        <p class="text-muted small mb-3">
                            <i class="bi bi-calendar-event"></i> @ev.Date &nbsp;|&nbsp; 
                            <i class="bi bi-geo-alt"></i> @ev.Distance
                        </p>

                        <!-- Enrolment Count Highlight -->
                        <div class="bg-light p-3 rounded-3 text-center mb-3">
                            <h4 class="mb-0 fw-bold text-primary">@ev.NumberOfEnrolment</h4>
                            <small class="text-muted text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Participants Enrolled</small>
                        </div>
                    </div>

                    <!-- Action Buttons Footer -->
                    <div class="card-footer bg-white border-top-0 pt-0 pb-3">
                        <!-- Top row of buttons -->
                        <div class="d-grid gap-2 mb-2">
                            <a asp-controller="EventEnrolment" asp-action="Index" asp-route-id="@ev.EventID" class="btn btn-outline-primary btn-sm fw-semibold">
                                View Participants
                            </a>
                        </div>
                        
                        <!-- Bottom row: Details, Edit, Delete -->
                        <div class="d-flex justify-content-between gap-1">
                            <a asp-action="Details" asp-route-id="@ev.EventID" class="btn btn-light btn-sm w-100 border">Details</a>
                            <a asp-action="Edit" asp-route-id="@ev.EventID" class="btn btn-light btn-sm w-100 border">Edit</a>
                            <a asp-action="Delete" asp-route-id="@ev.EventID" class="btn btn-light btn-sm w-100 border text-danger" onclick="return confirm('Are you sure you want to delete this event?');">Delete</a>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>

<!-- Add this if you want the icons to show up (Bootstrap Icons) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">